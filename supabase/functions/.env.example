# Secrets for the Edge Functions on your computer. Copy to supabase/functions/.env (git-ignored) and
# run `npx supabase functions serve --env-file supabase/functions/.env`. In production they're set
# with `npx supabase secrets set` instead. Step by step: docs/HOSTED_AI_SETUP.md.

# Hosted AI (supabase/functions/ai). Free local testing: run `node scripts/hosted-stub.mjs` and
# uncomment OPENROUTER_UPSTREAM (any OPENROUTER_API_KEY value works then). Never set it in production.
OPENROUTER_API_KEY=sk-or-...
# OPENROUTER_UPSTREAM=http://host.docker.internal:8787/v1/chat/completions
APP_ORIGINS=http://localhost:5173,http://127.0.0.1:5173
AI_DAILY_BUDGET_USD=20

# Starter and Pro through Dodo Payments (supabase/functions/billing): test mode first.
DODO_API_BASE=https://test.dodopayments.com
DODO_API_KEY=...
DODO_WEBHOOK_SECRET=whsec_...
DODO_PRODUCT_STARTER_MONTHLY=pdt_...
DODO_PRODUCT_STARTER_YEARLY=pdt_...
DODO_PRODUCT_PRO_MONTHLY=pdt_...
DODO_PRODUCT_PRO_YEARLY=pdt_...
