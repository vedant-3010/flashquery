# Optional: the account service (Supabase) for sign-in and, from M14, shared dashboards.
# Public values from Supabase → Project Settings → API (PRD D102). Copy to .env.local.
# Never put the secret or service-role key here, and never an LLM API key: users bring their own.
VITE_SUPABASE_URL=https://<project>.supabase.co
VITE_SUPABASE_PUBLISHABLE_KEY=sb_publishable_...

# Optional (D125): guests use Home and projects without an account, and can turn on a few free
# HushGlance AI questions a day. "true" asks for an account first again, as before (D115).
# VITE_SIGN_IN_REQUIRED=true
